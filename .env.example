NODE_ENV=development
PORT=3500
HOST_PORT=3500
APP_URL=http://localhost:3500
TZ=Europe/Moscow
TRUST_PROXY=false

DB_NAME=planner
DB_USER=planner
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password
DATABASE_URL=mysql://planner:change-me-db-password@db:3306/planner

SESSION_SECRET=change-me-32-bytes-minimum-secret-value
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

UPLOAD_DIR=/app/uploads
MAX_MODEL_MB=500
MAX_IMPORT_ZIP_MB=1000
MODEL_AUTO_OPTIMIZE_MB=15
MAX_IMAGE_MB=8
MAX_ORDER_ITEMS=100

# Production reverse proxy (Caddy)
DOMAIN=planner.example.com

# Уведомления о заказах (необязательно)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_TO=orders@example.com
